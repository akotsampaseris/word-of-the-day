{
  "name": "word-of-the-day",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx pipeline/cli.ts mock-assets && astro dev",
    "build": "tsx pipeline/cli.ts mock-assets && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pipeline:generate": "tsx pipeline/cli.ts generate",
    "pipeline:validate": "tsx pipeline/cli.ts validate",
    "pipeline:approve": "tsx pipeline/cli.ts approve",
    "pipeline:status": "tsx pipeline/cli.ts status",
    "pipeline:announce": "tsx pipeline/cli.ts announce",
    "pipeline:mock-assets": "tsx pipeline/cli.ts mock-assets"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@astrojs/rss": "^4.0.19",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@fal-ai/client": "^1.10.1",
    "astro": "^7.3.5",
    "cheerio": "^1.2.0",
    "openai": "^7.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
