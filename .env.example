# Word of the Day configuration.
# Copy to .env and fill in only what you need. Every variable is optional:
# with nothing set, the whole pipeline runs against mock providers.
# See the "Configuration" table in README.md for details.

# --- Site -------------------------------------------------------------------
SITE_URL=http://localhost:4321
SITE_TIMEZONE=UTC

# --- Pipeline ---------------------------------------------------------------
BUFFER_DAYS=14
MAX_ATTEMPTS=3
# Fail instead of falling back to mocks (CI sets this).
REQUIRE_REAL_PROVIDERS=

# --- Text: definition, etymology, story (auto | anthropic | openai | mock) ----
TEXT_PROVIDER=auto
# Default for anthropic is claude-haiku-4-5; for openai, gpt-6-luna.
TEXT_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Etymology sources (auto | wiktionary | mock) ---------------------------
SOURCE_PROVIDER=auto
# Wikimedia asks API clients to identify themselves with contact details.
WIKTIONARY_USER_AGENT="word-of-the-day/0.1 (https://your-site.example; you@example.com)"

# --- Images (auto | fal | openai | mock) ------------------------------------
IMAGE_PROVIDER=auto
# Default for fal is fal-ai/flux-2-pro; for openai, gpt-image-2.5-sunburst.
IMAGE_MODEL=
FAL_KEY=
# Optional comma-separated list of up to 3 image URLs to pin as style anchors.
STYLE_ANCHOR_URLS=

# --- Image storage: any S3-compatible bucket, e.g. Cloudflare R2 ------------
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public URL the bucket is served from, e.g. https://images.your-site.example
S3_PUBLIC_BASE_URL=
# For R2: https://<account-id>.r2.cloudflarestorage.com (leave empty for AWS S3)
S3_ENDPOINT=
# Defaults to "auto" when S3_ENDPOINT is set, otherwise us-east-1.
S3_REGION=
S3_KEY_PREFIX=images/
# Defaults to true when S3_ENDPOINT is set.
S3_FORCE_PATH_STYLE=
