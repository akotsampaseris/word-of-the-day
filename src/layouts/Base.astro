---
/**
 * The page shell: <head> with SEO and social-card tags, header and footer.
 * The OG/Twitter image is the whole distribution strategy for this site,
 * so every page that has an entry passes its image in.
 */
import '../styles/global.css';
import { absoluteUrl } from '../lib/format';
import { SITE_NAME } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/word/gongoozler/" */
  path: string;
  image?: { url: string; alt: string };
  type?: 'website' | 'article';
  publishedDate?: string;
}

const { title, description, path, image, type = 'website', publishedDate } = Astro.props;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(path, site).href;
const imageUrl = image ? absoluteUrl(image.url, site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={new URL('/rss.xml', site).href} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {image && imageUrl && <meta property="og:image" content={imageUrl} />}
    {image && <meta property="og:image:width" content="1024" />}
    {image && <meta property="og:image:height" content="1024" />}
    {image && <meta property="og:image:alt" content={image.alt} />}

    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {image && <meta name="twitter:image:alt" content={image.alt} />}
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">{SITE_NAME}</a>
      <nav aria-label="Main">
        <a href="/archive/">Archive</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>A new uncommon word every day. Etymologies are rewritten from the linked sources.</p>
    </footer>
  </body>
</html>
